  "fonts": {
    "DM Sans": {
      "substitute": "DM Sans",
      "google": "DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000"
    },
    "Chevy Sans": {
      "substitute": "DM Sans",
      "google": "DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000"
    },
