      "icons": {
        "font": "chevy-sc-icons",
        "dir": "chevrolet",
        "zip": "chevy-sc-icons-v1.0.zip"
      }
    },
    {
      "id": "gmc",
      "name": "GMC",
      "file": "gmc.css",
