    },
    "Buick Text": {
      "substitute": "Figtree",
      "google": "Figtree:wght@300..900"
    },
    "Buick Headline": {
      "substitute": "Lexend",
      "google": "Lexend:wght@300..700"
    },
    "Cadillac Gothic": {
      "substitute": "Archivo",
      "google": "Archivo:wght@300..800"
    },
    "Cadillac Gothic Narrow": {
