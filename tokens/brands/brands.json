{
  "$comment": "Brand registry. To add a brand: drop <id>.css into tokens/brands/source/, add an entry below, add its icon font (IcoMoon export: style.css + selection.json in tokens/brands/icons/<id>/, .woff/.ttf in assets/iconfonts/<id>/, zip in downloads/icons/), run `npm run build`. The header dropdown, Brand tokens page and Theme builder pick it up automatically.",
  "default": "base",
  "brands": [
    {
      "id": "base",
      "name": "DRS Base",
      "file": "base.css",
      "description": "Neutral DRS foundation. Every brand inherits from it.",
      "icons": {
        "font": "drs-sc-icons",
        "dir": "base",
        "zip": "drs-sc-icons-v1.0.zip"
      }
    },
    {
      "id": "chevrolet",
      "name": "Chevrolet",
